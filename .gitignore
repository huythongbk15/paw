# Python build artifacts
__pycache__/
*.pyc
*.pyo

# Benchmark per-run output (re-generated by the runner; per E0-01 review
# the run artifacts are not part of the source tree).
# E0-27's integration pack record lives at
# docs/benchmarks/e0/integration_pack_run.md instead.
benchmarks/e0/runs/

# Editor tmp files (nano et al. write these on save)
*.tmp
.*.tmp
build/
dist/

# Python virtual environments — never commit
.venv/
venv/
*.egg-info/

# Databases (runtime + test) — never commit
*.db
*.db-shm
*.db-wal

